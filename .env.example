# Copy to .env. Never commit .env.

# Which voice engine `npm run voice` uses:
#   local       Chatterbox on your GPU (tts/), voice cloned from voice/reference.wav. Free.
#   elevenlabs  the original cloud pipeline (needs the keys below).
TTS_PROVIDER=local
TTS_URL=http://127.0.0.1:7861

# Optional: ElevenLabs (only used when TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_SAMPLE_RATE=24000
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0
ELEVENLABS_SPEED=1.0
ELEVENLABS_SEED=42
