        "view": 10.881
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.013,
          "text": "Want proof?"
        },
        {
          "start": 1.396,
          "end": 2.51,
          "text": "On a Linux server,"
        },
        {
          "start": 2.685,
          "end": 4.635,
          "text": "run ps, the command that"
        },
        {
