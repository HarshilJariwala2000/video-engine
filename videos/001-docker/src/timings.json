  "scenes": {
    "scene01": {
      "duration": 18.45,
      "offset": 0,
      "cues": {
        "laptop": 0.2,
        "server": 2.801,
        "node": 5.413,
        "lib": 7.758,
        "cfg": 9.488,
        "promise": 11.148,
        "pack": 13.064,
        "same": 15.711
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.522,
          "text": "Your app works perfectly on your laptop."
        },
        {
          "start": 2.801,
          "end": 3.996,
          "text": "You put it on a server,"
        },
        {
          "start": 4.031,
          "end": 5.134,
          "text": "and it crashes."
        },
        {
          "start": 5.413,
          "end": 7.433,
          "text": "The server has a different Node version."
        },
        {
          "start": 7.758,
          "end": 9.163,
          "text": "A library is missing."
        },
        {
          "start": 9.488,
          "end": 10.765,
          "text": "A setting is different."
        },
        {
          "start": 11.148,
          "end": 12.739,
          "text": "Docker's promise is simple:"
        },
        {
          "start": 13.064,
          "end": 14.062,
          "text": "pack the app together"
        },
        {
          "start": 14.12,
          "end": 15.536,
          "text": "with everything it needs,"
        },
        {
          "start": 15.711,
          "end": 17.893,
          "text": "so it runs the same everywhere."
        }
      ]
    },
    "scene02": {
      "duration": 21.883333333333333,
      "offset": 18.45,
      "cues": {
        "named": 0.2,
        "strange": 2.673,
        "computer": 4.287,
        "files": 7.015,
        "net": 8.153,
        "fast": 9.546,
        "dozens": 11.346,
        "how": 14.028,
        "promise": 18.196
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.464,
          "text": "Docker calls that package a container."
        },
        {
          "start": 2.673,
          "end": 4.008,
          "text": "And here's the strange part."
        },
        {
          "start": 4.287,
          "end": 5.483,
          "text": "A container acts like"
        },
        {
          "start": 5.517,
          "end": 6.934,
          "text": "its own little computer,"
        },
        {
          "start": 7.015,
          "end": 9.302,
          "text": "with its own files and its own network."
        },
        {
          "start": 9.546,
          "end": 11.253,
          "text": "Yet it starts in about a second,"
        },
        {
          "start": 11.346,
          "end": 13.587,
          "text": "and your laptop can run dozens of them."
        },
        {
          "start": 14.028,
          "end": 15.619,
          "text": "How can something act like a whole"
        },
        {
          "start": 15.653,
          "end": 17.755,
          "text": "computer and cost almost nothing?"
        },
        {
          "start": 18.196,
          "end": 19.438,
          "text": "By the end of this video,"
        },
        {
          "start": 19.554,
          "end": 21.331,
          "text": "you'll know exactly how."
        }
      ]
    },
    "scene03": {
      "duration": 22.816666666666666,
      "offset": 40.333,
      "cues": {
        "build": 0.2,
        "four": 2.94,
        "one": 7.317,
        "two": 11.647,
        "three": 15.339,
        "fourth": 18.335
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.024,
          "text": "Let's pretend we're"
        },
        {
          "start": 1.048,
          "end": 2.615,
          "text": "building Docker ourselves."
        },
        {
          "start": 2.94,
          "end": 5.007,
          "text": "To run safely next to other apps,"
        },
        {
          "start": 5.123,
          "end": 6.876,
          "text": "our app needs four things."
        },
        {
          "start": 7.317,
          "end": 9.175,
          "text": "One: its own files,"
        },
        {
          "start": 9.209,
          "end": 11.264,
          "text": "in the exact versions it was built with."
        },
        {
          "start": 11.647,
          "end": 14.956,
          "text": "Two: it can't see or bump into other apps."
        },
        {
          "start": 15.339,
          "end": 18.01,
          "text": "Three: it can't hog the whole machine."
        },
        {
          "start": 18.335,
          "end": 20.065,
          "text": "And four: it has to be"
        },
        {
          "start": 20.123,
          "end": 22.259,
          "text": "cheap and quick to start."
        }
      ]
    },
    "scene04": {
      "duration": 15.666666666666666,
      "offset": 63.15,
      "cues": {
        "vm": 0.2,
        "pretend": 2.975,
        "each": 7.746,
        "os": 10.127,
        "apart": 12.46
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.65,
          "text": "The obvious answer is a virtual machine."
        },
        {
          "start": 2.975,
          "end": 4.496,
          "text": "That's a pretend computer,"
        },
        {
          "start": 4.647,
          "end": 5.796,
          "text": "made out of software,"
        },
        {
          "start": 5.97,
          "end": 7.421,
          "text": "running inside your real one."
        },
        {
          "start": 7.746,
          "end": 10.068,
          "text": "Give every app its own pretend computer,"
        },
        {
          "start": 10.127,
          "end": 12.286,
          "text": "with a full operating system inside,"
        },
        {
          "start": 12.46,
          "end": 13.458,
          "text": "and the apps can't"
        },
        {
          "start": 13.505,
          "end": 15.107,
          "text": "get in each other's way."
        }
      ]
    },
    "scene05": {
      "duration": 20.35,
      "offset": 78.817,
      "cues": {
        "zoom": 0.2,
        "kernel": 4.008,
        "manager": 8.257,
        "starts": 10.44,
        "memory": 12.24,
        "files": 13.273,
        "process": 15.792
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.117,
          "text": "One word matters for"
        },
        {
          "start": 1.164,
          "end": 2.267,
          "text": "the rest of this video,"
        },
        {
          "start": 2.336,
          "end": 3.683,
          "text": "so let's zoom in."
        },
        {
          "start": 4.008,
          "end": 5.668,
          "text": "At the center of every operating"
        },
        {
          "start": 5.726,
          "end": 8.014,
          "text": "system is a program called the kernel."
        },
        {
          "start": 8.257,
          "end": 10.196,
          "text": "Think of it as the computer's manager."
        },
        {
          "start": 10.44,
          "end": 12.066,
          "text": "It starts every program,"
        },
        {
          "start": 12.24,
          "end": 13.9,
          "text": "hands out memory, and decides"
        },
        {
          "start": 13.935,
          "end": 15.514,
          "text": "who can touch which files."
        },
        {
          "start": 15.792,
          "end": 16.675,
          "text": "And a program that's"
        },
        {
          "start": 16.721,
          "end": 18.114,
          "text": "running has a name too:"
        },
        {
          "start": 18.439,
          "end": 19.798,
          "text": "a process."
        }
      ]
    },
    "scene06": {
      "duration": 19.8,
      "offset": 99.167,
      "cues": {
        "back": 0.2,
        "kernels": 4.426,
        "three": 6.086,
        "but": 8.466,
        "boot": 11.717,
        "gb": 13.574,
        "fail": 16.024
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.767,
          "text": "So with virtual machines,"
        },
        {
          "start": 1.941,
          "end": 3.834,
          "text": "every app gets its own operating"
        },
        {
          "start": 3.892,
          "end": 5.703,
          "text": "system and its own kernel."
        },
        {
          "start": 6.086,
          "end": 8.222,
          "text": "That checks the first three boxes."
        },
        {
          "start": 8.466,
          "end": 9.987,
          "text": "But three apps means three"
        },
        {
          "start": 10.068,
          "end": 11.543,
          "text": "full operating systems,"
        },
        {
          "start": 11.717,
          "end": 13.423,
          "text": "each one booting from scratch,"
        },
        {
          "start": 13.574,
          "end": 15.583,
          "text": "each one using gigabytes of memory."
        },
        {
          "start": 16.024,
          "end": 19.24,
          "text": "Box four, cheap and quick, fails."
        }
      ]
    },
    "scene07": {
      "duration": 17.433333333333334,
      "offset": 118.967,
      "cues": {
        "better": 0.2,
        "need": 2.174,
        "believe": 4.774,
        "manager": 7.572,
        "decides": 10.185,
        "smaller": 13.156
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.849,
          "text": "So let's ask a better question."
        },
        {
          "start": 2.174,
          "end": 4.565,
          "text": "Does our app really need its own computer?"
        },
        {
          "start": 4.774,
          "end": 5.959,
          "text": "Or does it only need"
        },
        {
          "start": 5.993,
          "end": 7.247,
          "text": "to believe it has one?"
        },
        {
          "start": 7.572,
          "end": 9.976,
          "text": "Remember: the kernel is the manager."
        },
        {
          "start": 10.185,
          "end": 11.264,
          "text": "It already decides"
        },
        {
          "start": 11.288,
          "end": 12.947,
          "text": "what every process gets."
        },
        {
          "start": 13.156,
          "end": 14.584,
          "text": "So what if the kernel simply"
        },
        {
          "start": 14.642,
          "end": 16.871,
          "text": "showed our app a smaller world?"
        }
      ]
    },
    "scene08": {
      "duration": 17.616666666666667,
      "offset": 136.4,
      "cues": {
        "normal": 0.2,
        "others": 2.87,
        "ids": 4.763,
        "pid": 7.503,
        "files": 11.346,
        "net": 13.575,
        "nothing": 15.758
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.429,
          "text": "Here's what a normal process sees today."
        },
        {
          "start": 2.87,
          "end": 4.589,
          "text": "Every other program on the machine,"
        },
        {
          "start": 4.763,
          "end": 5.761,
          "text": "each one with an ID"
        },
        {
          "start": 5.912,
          "end": 7.178,
          "text": "number the kernel gave it."
        },
        {
          "start": 7.503,
          "end": 9.418,
          "text": "That number is called a PID,"
        },
        {
          "start": 9.5,
          "end": 11.02,
          "text": "short for process ID."
        },
        {
          "start": 11.346,
          "end": 13.552,
          "text": "It also sees every file on the disk,"
        },
        {
          "start": 13.575,
          "end": 15.375,
          "text": "and every network connection."
        },
        {
          "start": 15.758,
          "end": 17.058,
          "text": "Nothing is hidden."
        }
      ]
    },
    "scene09": {
      "duration": 25.233333333333334,
      "offset": 154.017,
      "cues": {
        "feature": 0.2,
        "blinders": 4.577,
        "sees": 6.992,
        "put": 10.405,
        "vanish": 11.868,
        "one": 13.911,
        "lie": 19.228,
        "outside": 20.448
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.476,
          "text": "Linux has a feature for exactly this,"
        },
        {
          "start": 2.568,
          "end": 4.194,
          "text": "called namespaces."
        },
        {
          "start": 4.577,
          "end": 6.667,
          "text": "Think of a namespace as blinders."
        },
        {
          "start": 6.992,
          "end": 8.966,
          "text": "It changes what a process can see,"
        },
        {
          "start": 9.047,
          "end": 10.022,
          "text": "and nothing else."
        },
        {
          "start": 10.405,
          "end": 11.822,
          "text": "Put blinders on our app,"
        },
        {
          "start": 11.868,
          "end": 13.667,
          "text": "and the other programs vanish."
        },
        {
          "start": 13.911,
          "end": 16.303,
          "text": "It even believes it's process number one,"
        },
        {
          "start": 16.477,
          "end": 18.845,
          "text": "the very first program on the machine."
        },
        {
          "start": 19.228,
          "end": 20.064,
          "text": "That's a lie."
        },
        {
          "start": 20.448,
          "end": 21.794,
          "text": "From the outside, it's"
        },
        {
          "start": 21.841,
          "end": 24.674,
          "text": "still process 48213."
        }
      ]
    },
    "scene10": {
      "duration": 16.316666666666666,
      "offset": 179.25,
      "cues": {
        "same": 0.2,
        "point": 2.58,
        "world": 5.575,
        "top": 8.199,
        "inside": 10.707,
        "invisible": 13.33
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.139,
          "text": "The same blinders work for files."
        },
        {
          "start": 2.58,
          "end": 4.24,
          "text": "Point the app at one ordinary"
        },
        {
          "start": 4.322,
          "end": 5.424,
          "text": "folder on the server,"
        },
        {
          "start": 5.575,
          "end": 7.816,
          "text": "and that folder becomes its whole world."
        },
        {
          "start": 8.199,
          "end": 9.012,
          "text": "When the app looks at"
        },
        {
          "start": 9.047,
          "end": 10.533,
          "text": "the top of its file system,"
        },
        {
          "start": 10.707,
          "end": 13.087,
          "text": "all it finds is what's inside that folder."
        },
        {
          "start": 13.33,
          "end": 15.757,
          "text": "Everything else on the disk is invisible."
        }
      ]
    },
    "scene11": {
      "duration": 17.516666666666666,
      "offset": 195.567,
      "cues": {
        "net": 0.2,
        "addr": 1.791,
        "two": 4.275,
        "std": 6.864,
        "collide": 8.606,
        "only": 10.301,
        "box": 12.542
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.547,
          "text": "And the same for the network."
        },
        {
          "start": 1.791,
          "end": 3.996,
          "text": "The app gets its own network address."
        },
        {
          "start": 4.275,
          "end": 6.69,
          "text": "So two apps can both use port 80,"
        },
        {
          "start": 6.864,
          "end": 8.548,
          "text": "the standard port for websites,"
        },
        {
          "start": 8.606,
          "end": 9.859,
          "text": "and they never collide."
        },
        {
          "start": 10.301,
          "end": 12.159,
          "text": "Each one thinks it's the only one."
        },
        {
          "start": 12.542,
          "end": 14.748,
          "text": "That's box two: our app can't"
        },
        {
          "start": 14.817,
          "end": 16.965,
          "text": "see or bump into anything else."
        }
      ]
    },
    "scene12": {
      "duration": 23.65,
      "offset": 213.083,
      "cues": {
        "hide": 0.2,
        "eat": 2.394,
        "slow": 4.774,
        "cg": 6.539,
        "budget": 11.148,
        "cpu": 13.064,
        "mem": 15.212,
        "over": 17.626,
        "kill": 19.705,
        "box": 21.504
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.116,
          "text": "But blinders only hide things."
        },
        {
          "start": 2.394,
          "end": 4.147,
          "text": "A hidden app can still eat all"
        },
        {
          "start": 4.205,
          "end": 6.156,
          "text": "the memory and slow everyone down."
        },
        {
          "start": 6.539,
          "end": 8.257,
          "text": "So Linux has a second feature,"
        },
        {
          "start": 8.35,
          "end": 10.87,
          "text": "called control groups, or cgroups."
        },
        {
          "start": 11.148,
          "end": 12.82,
          "text": "A cgroup is a budget."
        },
        {
          "start": 13.064,
          "end": 14.887,
          "text": "Half of one CPU core."
        },
        {
          "start": 15.212,
          "end": 17.301,
          "text": "512 megabytes of memory."
        },
        {
          "start": 17.626,
          "end": 19.623,
          "text": "If the app goes over its memory budget,"
        },
        {
          "start": 19.705,
          "end": 21.121,
          "text": "the kernel shuts it down."
        },
        {
          "start": 21.504,
          "end": 23.095,
          "text": "That's box three."
        }
      ]
    },
    "scene13": {
      "duration": 26.35,
      "offset": 236.733,
      "cues": {
        "look": 0.2,
        "machine": 2.267,
        "kernel": 3.416,
        "procs": 4.612,
        "noos": 8.954,
        "start": 11.81,
        "sec": 14.875,
        "box": 17.231,
        "done": 18.52,
        "trick": 22.491
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.883,
          "text": "Now look at what we've built."
        },
        {
          "start": 2.267,
          "end": 3.137,
          "text": "One machine."
        },
        {
          "start": 3.416,
          "end": 4.287,
          "text": "One kernel."
        },
        {
          "start": 4.612,
          "end": 6.713,
          "text": "And a few ordinary processes,"
        },
        {
          "start": 6.841,
          "end": 8.629,
          "text": "each with blinders and a budget."
        },
        {
          "start": 8.954,
          "end": 10.394,
          "text": "There's no second operating"
        },
        {
          "start": 10.452,
          "end": 11.427,
          "text": "system to boot."
        },
        {
          "start": 11.81,
          "end": 12.854,
          "text": "Starting a container"
        },
        {
          "start": 12.947,
          "end": 14.724,
          "text": "is just starting a process,"
        },
        {
          "start": 14.875,
          "end": 16.79,
          "text": "and that's why it takes about a second."
        },
        {
          "start": 17.231,
          "end": 18.195,
          "text": "Box four."
        },
        {
          "start": 18.52,
          "end": 20.32,
          "text": "Three boxes done, and they"
        },
        {
          "start": 20.389,
          "end": 22.166,
          "text": "all came from the same trick:"
        },
        {
          "start": 22.491,
          "end": 23.478,
          "text": "the kernel showing a"
        },
        {
          "start": 23.547,
          "end": 25.788,
          "text": "process a smaller world."
        }
      ]
    },
    "scene14": {
      "duration": 15.016666666666667,
      "offset": 263.083,
      "cues": {
        "catch": 0.2,
        "linux": 1.524,
        "mac": 4.867,
        "one": 11.52
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.14,
          "text": "One catch."
        },
        {
          "start": 1.524,
          "end": 2.882,
          "text": "These blinders and budgets"
        },
        {
          "start": 2.94,
          "end": 4.623,
          "text": "are Linux kernel features."
        },
        {
          "start": 4.867,
          "end": 6.423,
          "text": "So on a Mac or Windows,"
        },
        {
          "start": 6.551,
          "end": 9.175,
          "text": "Docker Desktop quietly runs one small"
        },
        {
          "start": 9.256,
          "end": 11.311,
          "text": "Linux virtual machine in the background."
        },
        {
          "start": 11.52,
          "end": 14.457,
          "text": "Just one, shared by all your containers."
        }
      ]
    },
    "scene15": {
      "duration": 24.716666666666665,
      "offset": 278.1,
      "cues": {
        "left": 0.2,
        "crash": 3.23,
        "wrong": 5.32,
        "ship": 7.712,
        "image": 10.568,
        "holds": 12.762,
        "node": 15.119,
        "libs": 16.43,
        "code": 17.29,
        "fill": 18.555,
        "box": 22.886
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.789,
          "text": "That leaves box one: the files."
        },
        {
          "start": 3.23,
          "end": 4.937,
          "text": "Remember the crash from the beginning?"
        },
        {
          "start": 5.32,
          "end": 7.27,
          "text": "The server had the wrong files."
        },
        {
          "start": 7.712,
          "end": 8.884,
          "text": "So the fix is to ship"
        },
        {
          "start": 8.942,
          "end": 10.185,
          "text": "the files with the app."
        },
        {
          "start": 10.568,
          "end": 12.437,
          "text": "That bundle is called an image."
        },
        {
          "start": 12.762,
          "end": 15.026,
          "text": "It holds a small set of Linux tools,"
        },
        {
          "start": 15.119,
          "end": 16.28,
          "text": "the right Node version,"
        },
        {
          "start": 16.43,
          "end": 18.172,
          "text": "your libraries, and your code."
        },
        {
          "start": 18.555,
          "end": 19.844,
          "text": "When the container starts,"
        },
        {
          "start": 19.937,
          "end": 21.26,
          "text": "the image's files fill"
        },
        {
          "start": 21.341,
          "end": 22.444,
          "text": "that private folder."
        },
        {
          "start": 22.886,
          "end": 24.163,
          "text": "Box one."
        }
      ]
    },
    "scene16": {
      "duration": 15.766666666666667,
      "offset": 302.817,
      "cues": {
        "notice": 0.2,
        "kernel": 3.102,
        "files": 4.322,
        "server": 6.411,
        "size": 8.687,
        "vm": 11.566
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.777,
          "text": "Now notice what an image does not contain:"
        },
        {
          "start": 3.102,
          "end": 3.88,
          "text": "a kernel."
        },
        {
          "start": 4.322,
          "end": 6.086,
          "text": "The image brings the files."
        },
        {
          "start": 6.411,
          "end": 8.246,
          "text": "The server brings the kernel."
        },
        {
          "start": 8.687,
          "end": 9.743,
          "text": "That's why an image is"
        },
        {
          "start": 9.825,
          "end": 11.45,
          "text": "often tens of megabytes,"
        },
        {
          "start": 11.566,
          "end": 12.716,
          "text": "while a virtual machine's"
        },
        {
          "start": 12.832,
          "end": 15.2,
          "text": "disk is usually gigabytes."
        }
      ]
    },
    "scene17": {
      "duration": 20.316666666666666,
      "offset": 318.583,
      "cues": {
        "recipe": 0.2,
        "layer": 4.171,
        "base": 9.07,
        "deps": 12.007,
        "install": 14.202,
        "code": 15.386,
        "four": 17.336
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.512,
          "text": "You describe an image with a"
        },
        {
          "start": 1.582,
          "end": 3.787,
          "text": "short recipe called a Dockerfile."
        },
        {
          "start": 4.171,
          "end": 5.645,
          "text": "Each step adds a layer:"
        },
        {
          "start": 5.924,
          "end": 7.201,
          "text": "a set of files stacked"
        },
        {
          "start": 7.236,
          "end": 8.687,
          "text": "on top of the step before."
        },
        {
          "start": 9.07,
          "end": 10.115,
          "text": "Start from a base with"
        },
        {
          "start": 10.185,
          "end": 11.682,
          "text": "Linux tools and Node."
        },
        {
          "start": 12.007,
          "end": 13.958,
          "text": "Copy in your list of dependencies."
        },
        {
          "start": 14.202,
          "end": 15.061,
          "text": "Install them."
        },
        {
          "start": 15.386,
          "end": 17.011,
          "text": "Then copy in your code."
        },
        {
          "start": 17.336,
          "end": 19.751,
          "text": "Four steps, four layers."
        }
      ]
    },
    "scene18": {
      "duration": 25.883333333333333,
      "offset": 338.9,
      "cues": {
        "know": 0.2,
        "ro": 2.371,
        "thin": 6.226,
        "copy": 11.856,
        "cow": 16.233,
        "share": 18.834,
        "clean": 21.55
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.988,
          "text": "Here's what most people don't know."
        },
        {
          "start": 2.371,
          "end": 4.391,
          "text": "Image layers are read-only."
        },
        {
          "start": 4.67,
          "end": 5.842,
          "text": "They never change."
        },
        {
          "start": 6.226,
          "end": 7.584,
          "text": "When a container runs,"
        },
        {
          "start": 7.7,
          "end": 9.987,
          "text": "Docker adds one thin layer on top,"
        },
        {
          "start": 10.161,
          "end": 11.415,
          "text": "just for that container."
        },
        {
          "start": 11.856,
          "end": 14.05,
          "text": "Any file the app changes is copied"
        },
        {
          "start": 14.085,
          "end": 15.908,
          "text": "up into that top layer first."
        },
        {
          "start": 16.233,
          "end": 18.45,
          "text": "This trick is called copy-on-write."
        },
        {
          "start": 18.834,
          "end": 20.111,
          "text": "It's why ten containers"
        },
        {
          "start": 20.169,
          "end": 21.434,
          "text": "can share one image,"
        },
        {
          "start": 21.55,
          "end": 22.827,
          "text": "and why a fresh container"
        },
        {
          "start": 22.92,
          "end": 25.323,
          "text": "always starts perfectly clean."
        }
      ]
    },
    "scene19": {
      "duration": 23.466666666666665,
      "offset": 364.783,
      "cues": {
        "fast": 0.2,
        "keeps": 2.719,
        "change": 5.308,
        "reused": 7.143,
        "last": 11.578,
        "good": 13.784,
        "other": 18.277,
        "every": 19.67
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.394,
          "text": "Layers also make rebuilds fast."
        },
        {
          "start": 2.719,
          "end": 4.983,
          "text": "Docker keeps every layer it has built."
        },
        {
          "start": 5.308,
          "end": 6.992,
          "text": "Change one line of your code,"
        },
        {
          "start": 7.143,
          "end": 8.838,
          "text": "and every step before copying"
        },
        {
          "start": 8.884,
          "end": 11.195,
          "text": "your code is reused as-is."
        },
        {
          "start": 11.578,
          "end": 13.459,
          "text": "Only the last steps run again."
        },
        {
          "start": 13.784,
          "end": 15.723,
          "text": "That's why good Dockerfiles install"
        },
        {
          "start": 15.792,
          "end": 18.033,
          "text": "dependencies before copying the code."
        },
        {
          "start": 18.277,
          "end": 19.612,
          "text": "Do it the other way around,"
        },
        {
          "start": 19.67,
          "end": 22.909,
          "text": "and every tiny edit reinstalls everything."
        }
      ]
    },
    "scene20": {
      "duration": 17.933333333333334,
      "offset": 388.25,
      "cues": {
        "together": 0.2,
        "proc": 1.976,
        "ns": 4.67,
        "cg": 7.12,
        "img": 9.639,
        "not": 12.193,
        "lie": 14.016
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.651,
          "text": "So let's put it all together."
        },
        {
          "start": 1.976,
          "end": 4.345,
          "text": "A container is a normal process."
        },
        {
          "start": 4.67,
          "end": 6.841,
          "text": "Namespaces decide what it can see."
        },
        {
          "start": 7.12,
          "end": 9.395,
          "text": "Cgroups decide how much it can use."
        },
        {
          "start": 9.639,
          "end": 11.914,
          "text": "And an image gives it its own files."
        },
        {
          "start": 12.193,
          "end": 13.807,
          "text": "It isn't a tiny computer."
        },
        {
          "start": 14.016,
          "end": 15.49,
          "text": "It's an ordinary process"
        },
        {
          "start": 15.525,
          "end": 17.382,
          "text": "that the kernel is lying to."
        }
      ]
    },
    "scene21": {
      "duration": 23.933333333333334,
      "offset": 406.183,
      "cues": {
        "watch": 0.2,
        "pull": 2.418,
        "stack": 5.657,
        "blind": 8.675,
        "budget": 9.871,
        "start": 11.322,
        "same": 14.921,
        "works": 17.452,
        "fast": 19.519
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.092,
          "text": "Now watch docker run again."
        },
        {
          "start": 2.418,
          "end": 3.95,
          "text": "Docker downloads any image"
        },
        {
          "start": 4.008,
          "end": 5.378,
          "text": "layers you don't have yet."
        },
        {
          "start": 5.657,
          "end": 7.05,
          "text": "It stacks them and adds"
        },
        {
          "start": 7.085,
          "end": 8.397,
          "text": "a thin writable layer."
        },
        {
          "start": 8.675,
          "end": 9.825,
          "text": "It puts on the blinders"
        },
        {
          "start": 9.871,
          "end": 11.044,
          "text": "and sets the budget."
        },
        {
          "start": 11.322,
          "end": 12.553,
          "text": "Then it starts your app"
        },
        {
          "start": 12.623,
          "end": 14.643,
          "text": "as one ordinary process."
        },
        {
          "start": 14.921,
          "end": 15.932,
          "text": "The same files on your"
        },
        {
          "start": 15.978,
          "end": 17.383,
          "text": "laptop and on the server,"
        },
        {
          "start": 17.452,
          "end": 19.31,
          "text": "so no more works on my machine."
        },
        {
          "start": 19.519,
          "end": 21.307,
          "text": "And no extra operating system,"
        },
        {
          "start": 21.365,
          "end": 23.374,
          "text": "so it starts in about a second."
        }
      ]
    },
    "scene22": {
      "duration": 13.3,
      "offset": 430.117,
      "cues": {
