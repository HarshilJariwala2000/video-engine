          "start": 0.2,
          "end": 1.84,
          "text": "Back to our report."
        },
        {
          "start": 1.908,
          "end": 3.538,
          "text": "It took its photo before"
        },
        {
          "start": 3.606,
          "end": 5.246,
          "text": "ticket 42 finished."
        },
        {
          "start": 5.314,
          "end": 7.162,
          "text": "So it sees the old alice,"
        },
        {
          "start": 7.23,
