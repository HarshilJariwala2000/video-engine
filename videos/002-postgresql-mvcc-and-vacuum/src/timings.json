      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.452,
          "text": "Want to ruin your afternoon?"
        },
        {
          "start": 2.519,
          "end": 4.013,
          "text": "Take an accounts table"
        },
        {
          "start": 4.081,
          "end": 5.858,
          "text": "with 20 million rows."
        },
        {
          "start": 5.925,
          "end": 8.245,
          "text": "It uses 10 gigabytes of disk."
        },
        {
          "start": 8.313,
          "end": 11.315,
          "text": "You delete the 10 million closed accounts,"
        },
        {
          "start": 11.383,
          "end": 14.314,
          "text": "and the row count drops to 10 million."
        },
        {
          "start": 14.382,
          "end": 16.361,
          "text": "Then you check the disk."
        },
        {
          "start": 16.429,
          "end": 17.662,
          "text": "10 gigabytes."
        },
        {
          "start": 17.73,
          "end": 18.488,
          "text": "Not 9."
        },
        {
          "start": 18.556,
          "end": 20.4,
          "text": "Not even 9 and a half."
        },
        {
          "start": 20.467,
          "end": 23.266,
          "text": "And Sam from infra leans over and says:"
        },
        {
          "start": 23.334,
          "end": 24.974,
          "text": "you need to vacuum."
        },
        {
          "start": 25.042,
          "end": 27.623,
          "text": "Which sounds less like database advice"
        },
        {
          "start": 27.691,
          "end": 30.961,
          "text": "and more like something your mom would say."
        }
      ]
    },
    "scene02": {
      "duration": 30.85,
      "offset": 31.517,
      "cues": {
        "gone": 0.2,
        "space": 2.995,
        "stranger": 5.518,
        "update": 8.449,
        "double": 10.772,
        "never": 13.906,
        "promise": 19.432,
        "why": 26.951
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.927,
          "text": "The rows are gone from every query."
        },
        {
          "start": 2.995,
          "end": 5.45,
          "text": "But their space is still taken."
        },
        {
          "start": 5.518,
          "end": 8.381,
          "text": "Now try something even more innocent."
        },
        {
          "start": 8.449,
          "end": 10.704,
          "text": "Change one column in every row,"
        },
        {
          "start": 10.772,
          "end": 13.838,
          "text": "and the table can almost double in size."
        },
        {
          "start": 13.906,
          "end": 16.297,
          "text": "My favourite fact about Postgres:"
        },
        {
          "start": 16.365,
          "end": 19.364,
          "text": "it has never updated a row in its life."
        },
        {
          "start": 19.432,
          "end": 21.276,
          "text": "Postgres is a hoarder."
        },
        {
          "start": 21.344,
          "end": 23.391,
          "text": "A very organised hoarder."
        },
        {
          "start": 23.459,
          "end": 25.171,
          "text": "By the end, you'll know"
        },
        {
          "start": 25.239,
          "end": 26.883,
          "text": "exactly what it keeps,"
        },
        {
          "start": 26.951,
          "end": 28.581,
          "text": "and why I think hoarding"
        },
        {
          "start": 28.649,
          "end": 30.289,
          "text": "was the right call."
        }
      ]
    },
    "intro": {
      "duration": 7,
