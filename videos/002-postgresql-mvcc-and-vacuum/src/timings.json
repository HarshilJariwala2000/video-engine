        },
        {
          "start": 9.714,
          "end": 10.961,
          "text": "Total: 200."
        },
        {
          "start": 11.029,
          "end": 12.726,
          "text": "Now a second query starts"
        },
        {
          "start": 12.794,
          "end": 14.706,
          "text": "just after 42 finishes."
        },
        {
          "start": 14.774,
          "end": 17.094,
          "text": "It sees alice 50 and bob 150."
        },
        {
          "start": 17.161,
          "end": 18.123,
          "text": "Also 200."
        },
        {
          "start": 18.191,
          "end": 20.188,
          "text": "Same table, same instant,"
        },
        {
          "start": 20.256,
          "end": 21.9,
          "text": "two different answers,"
        },
        {
          "start": 21.968,
          "end": 23.609,
          "text": "and both are right."
        },
        {
          "start": 23.676,
          "end": 25.588,
          "text": "That sounds like a bug."
        },
        {
          "start": 25.656,
          "end": 27.636,
          "text": "It's the entire feature."
        },
        {
          "start": 27.704,
          "end": 30.092,
          "text": "And nobody waited for anybody."
        },
        {
          "start": 30.159,
          "end": 31.532,
          "text": "Three out of four,"
        },
        {
          "start": 31.6,
          "end": 33.444,
