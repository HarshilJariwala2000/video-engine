    "scene03": {
      "duration": 34.46666666666667,
      "offset": 69.367,
      "cues": {
        "build": 0.2,
        "rows": 4.149,
        "report": 7.72,
        "pay": 10.582,
        "four": 15.972,
        "r1": 19.8,
        "r2": 21.997,
        "r3": 25.01,
        "r4": 30.006
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.102,
          "text": "Let's pretend we're building"
        },
        {
          "start": 2.169,
          "end": 4.081,
          "text": "the database ourselves."
        },
        {
          "start": 4.149,
          "end": 6.079,
          "text": "Two rows: alice and bob,"
        },
        {
          "start": 6.147,
          "end": 7.652,
          "text": "100 dollars each."
        },
        {
          "start": 7.72,
          "end": 10.514,
          "text": "A report is adding up all the money."
        },
        {
          "start": 10.582,
          "end": 12.43,
          "text": "At the exact same moment,"
        },
        {
          "start": 12.498,
          "end": 14.264,
          "text": "a payment moves 50 dollars"
        },
        {
          "start": 14.332,
          "end": 15.904,
          "text": "from alice to bob."
        },
        {
          "start": 15.972,
          "end": 17.48,
          "text": "To survive that, our"
        },
        {
          "start": 17.548,
          "end": 19.732,
          "text": "database needs four things."
        },
        {
          "start": 19.8,
          "end": 21.929,
          "text": "One: readers never wait."
        },
        {
          "start": 21.997,
          "end": 24.942,
          "text": "Two: writers never wait for readers."
        },
        {
          "start": 25.01,
          "end": 28.094,
          "text": "Three: every query sees one clean moment,"
        },
        {
          "start": 28.162,
          "end": 29.939,
          "text": "never half a payment."
        },
        {
          "start": 30.006,
          "end": 32.412,
          "text": "And four: if the payment fails,"
        },
        {
          "start": 32.48,
          "end": 33.916,
          "text": "undo is instant."
        }
      ]
    },
    "scene04": {
      "duration": 28.05,
      "offset": 103.833,
      "cues": {
        "obvious": 0.2,
        "reads": 4.789,
        "pay": 7.258,
        "after": 10.936,
        "bob": 12.726,
        "total": 15.399,
        "money": 17.258,
        "fail": 25.167
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.64,
          "text": "The obvious design:"
        },
        {
          "start": 1.708,
          "end": 4.721,
          "text": "when something changes, overwrite it."
        },
        {
          "start": 4.789,
          "end": 7.19,
          "text": "The report reads alice: 100."
        },
        {
          "start": 7.258,
          "end": 8.752,
          "text": "Then the payment lands"
        },
        {
          "start": 8.82,
          "end": 10.868,
          "text": "and overwrites both rows."
        },
        {
          "start": 10.936,
          "end": 12.658,
          "text": "Alice 50, bob 150."
        },
        {
          "start": 12.726,
          "end": 15.332,
          "text": "Then the report reads bob: 150."
        },
        {
          "start": 15.399,
          "end": 17.19,
          "text": "Total: 250 dollars."
        },
        {
          "start": 17.258,
          "end": 18.48,
          "text": "Fifty dollars just"
        },
        {
          "start": 18.548,
          "end": 20.596,
          "text": "appeared out of thin air."
        },
        {
          "start": 20.664,
          "end": 22.983,
          "text": "Great news for alice and bob."
        },
        {
          "start": 23.051,
          "end": 25.099,
          "text": "Terrible news for a bank."
        },
        {
          "start": 25.167,
          "end": 27.486,
          "text": "So much for one clean moment."
        }
      ]
    },
    "scene05": {
      "duration": 36,
      "offset": 131.883,
      "cues": {
        "fix": 0.2,
        "sign": 2.252,
        "while": 4.978,
        "writes": 8.399,
        "clean": 11.887,
        "but": 14.206,
        "fail": 21.032,
        "undo": 23.624,
        "back": 27.033,
        "four": 30.453
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.184,
          "text": "The textbook fix is a lock:"
        },
        {
          "start": 2.252,
          "end": 4.911,
          "text": "a do not disturb sign on the rows."
        },
        {
          "start": 4.978,
          "end": 6.69,
          "text": "While the report reads,"
        },
        {
          "start": 6.758,
          "end": 8.331,
          "text": "the payment waits."
        },
        {
          "start": 8.399,
          "end": 10.246,
          "text": "While the payment writes,"
        },
        {
          "start": 10.314,
          "end": 11.819,
          "text": "the report waits."
        },
        {
          "start": 11.887,
          "end": 14.138,
          "text": "Every total comes out clean."
        },
        {
          "start": 14.206,
          "end": 16.108,
          "text": "But now everyone is politely"
        },
        {
          "start": 16.176,
          "end": 18.291,
          "text": "waiting for everyone else."
        },
        {
          "start": 18.359,
          "end": 20.965,
          "text": "It's a four-way stop, for data."
        },
        {
          "start": 21.032,
          "end": 23.556,
          "text": "So much for the first two boxes."
        },
        {
          "start": 23.624,
          "end": 25.05,
          "text": "And undo means saving"
        },
        {
          "start": 25.118,
          "end": 26.965,
          "text": "the old values somewhere,"
        },
        {
          "start": 27.033,
          "end": 28.745,
          "text": "then copying them back,"
        },
        {
          "start": 28.813,
          "end": 30.386,
          "text": "one row at a time."
        },
        {
          "start": 30.453,
          "end": 31.826,
          "text": "On a million rows,"
        },
        {
          "start": 31.894,
          "end": 33.534,
          "text": "that's not instant."
        },
        {
          "start": 33.602,
          "end": 35.446,
          "text": "That's a coffee break."
        }
      ]
    },
    "scene06": {
      "duration": 28.816666666666666,
      "offset": 167.883,
      "cues": {
        "reset": 0.2,
        "keep": 5.6,
        "what": 9.428,
        "never": 12.494,
        "old": 15.9,
        "new": 18.967,
        "both": 22.93
      },
      "captions": [
        {
          "start": 0.2,
          "end": 0.89,
          "text": "Okay."
        },
        {
          "start": 0.957,
          "end": 3.349,
          "text": "Let's look under the abstraction,"
        },
        {
          "start": 3.416,
          "end": 5.532,
          "text": "and ask a better question."
        },
        {
          "start": 5.6,
          "end": 7.108,
          "text": "To undo anything, we"
        },
        {
          "start": 7.176,
          "end": 9.36,
          "text": "already need the old value."
        },
        {
          "start": 9.428,
          "end": 12.426,
          "text": "So what if we just never threw it away?"
        },
        {
          "start": 12.494,
          "end": 13.852,
          "text": "What if nothing ever"
        },
        {
          "start": 13.92,
          "end": 15.832,
          "text": "got overwritten at all?"
        },
        {
          "start": 15.9,
          "end": 18.899,
          "text": "The report keeps reading the old alice."
        },
        {
          "start": 18.967,
          "end": 21.222,
          "text": "The payment writes a new alice,"
        },
        {
          "start": 21.29,
          "end": 22.862,
          "text": "right next to her."
        },
        {
          "start": 22.93,
          "end": 24.163,
          "text": "Nobody waits."
        },
        {
          "start": 24.231,
          "end": 26.822,
          "text": "It's not a four-way stop anymore."
        },
        {
          "start": 26.89,
          "end": 28.259,
          "text": "It's two lanes."
        }
      ]
    },
    "scene07": {
      "duration": 30,
      "offset": 196.7,
      "cues": {
        "that": 0.2,
        "update": 3.266,
        "copy": 4.978,
        "balance": 9.146,
        "old": 10.99,
        "expired": 13.788,
        "version": 16.937,
        "insert": 19.664
      },
      "captions": [
        {
          "start": 0.2,
          "end": 3.199,
          "text": "And that is exactly what Postgres does."
        },
        {
          "start": 3.266,
          "end": 4.911,
          "text": "When you update alice,"
        },
        {
          "start": 4.978,
          "end": 7.026,
          "text": "it doesn't touch her row."
        },
        {
          "start": 7.094,
          "end": 9.078,
          "text": "It writes a whole new copy,"
        },
        {
          "start": 9.146,
          "end": 10.922,
          "text": "with the new balance."
        },
        {
          "start": 10.99,
          "end": 13.72,
          "text": "The old copy stays right where it was,"
        },
        {
          "start": 13.788,
          "end": 16.869,
          "text": "with a little note that says: expired."
        },
        {
          "start": 16.937,
          "end": 19.596,
          "text": "Each copy is called a row version."
        },
        {
          "start": 19.664,
          "end": 22.055,
          "text": "So an update is really an insert,"
        },
        {
          "start": 22.123,
          "end": 23.899,
          "text": "with extra paperwork."
        },
        {
          "start": 23.967,
          "end": 25.611,
          "text": "You might be thinking:"
        },
        {
          "start": 25.679,
          "end": 27.455,
          "text": "that sounds wasteful."
        },
        {
          "start": 27.523,
          "end": 28.28,
          "text": "It is."
        },
        {
          "start": 28.348,
          "end": 29.445,
          "text": "On purpose."
        }
      ]
    },
    "scene08": {
      "duration": 25.266666666666666,
      "offset": 226.7,
      "cues": {
        "mark": 0.2,
        "group": 4.231,
        "name": 10.246,
        "ticket": 14.332,
        "up": 20.676,
        "ours": 22.384
      },
      "captions": [
        {
          "start": 0.2,
          "end": 3.134,
          "text": "But that note has to say who expired her,"
        },
        {
          "start": 3.202,
          "end": 4.163,
          "text": "and when."
        },
        {
          "start": 4.231,
          "end": 6.351,
          "text": "Our payment changes two rows,"
        },
        {
          "start": 6.419,
          "end": 8.81,
          "text": "and they have to happen together,"
        },
        {
          "start": 8.878,
          "end": 10.179,
          "text": "or not at all."
        },
        {
          "start": 10.246,
          "end": 11.876,
          "text": "A bundle of changes like"
        },
        {
          "start": 11.944,
          "end": 14.264,
          "text": "that is called a transaction."
        },
        {
          "start": 14.332,
          "end": 15.826,
          "text": "Every transaction that"
        },
        {
          "start": 15.894,
          "end": 18.013,
          "text": "writes takes a ticket number,"
        },
        {
          "start": 18.081,
          "end": 20.608,
          "text": "like the machine at a deli counter,"
        },
        {
          "start": 20.676,
          "end": 22.316,
          "text": "always counting up."
        },
        {
          "start": 22.384,
          "end": 24.703,
          "text": "Our payment pulled number 42."
        }
      ]
    },
    "scene09": {
      "duration": 33.15,
      "offset": 251.967,
      "cues": {
        "every": 0.2,
        "two": 3.606,
        "created": 11.44,
        "deleted": 14.521,
        "oldalice": 17.738,
        "newalice": 21.715,
        "names": 26.522
      },
      "captions": [
        {
          "start": 0.2,
          "end": 1.694,
          "text": "This is the bit I find"
        },
        {
          "start": 1.762,
          "end": 3.538,
          "text": "genuinely delightful."
        },
        {
          "start": 3.606,
          "end": 5.304,
          "text": "Postgres labels every row"
        },
        {
          "start": 5.372,
          "end": 7.627,
          "text": "version with two hidden stamps,"
        },
        {
          "start": 7.695,
          "end": 9.325,
          "text": "like a hoarder labelling"
        },
        {
          "start": 9.393,
          "end": 11.373,
          "text": "every box in the garage."
        },
        {
          "start": 11.44,
          "end": 14.453,
          "text": "Created by: the ticket that wrote it."
        },
        {
          "start": 14.521,
          "end": 17.67,
          "text": "Deleted by: the ticket that expired it."
        },
        {
          "start": 17.738,
          "end": 19.178,
          "text": "The old alice says:"
        },
        {
          "start": 19.246,
          "end": 21.647,
          "text": "created by 7, deleted by 42."
        },
        {
          "start": 21.715,
          "end": 23.156,
          "text": "The new alice says:"
        },
        {
          "start": 23.224,
          "end": 26.454,
          "text": "created by 42, deleted by nobody, yet."
        },
        {
          "start": 26.522,
          "end": 29.049,
          "text": "Postgres calls these xmin and xmax,"
        },
        {
          "start": 29.117,
          "end": 30.815,
          "text": "which might be why you've"
        },
        {
          "start": 30.883,
          "end": 32.591,
          "text": "never heard of them."
        }
      ]
    },
    "scene10": {
      "duration": 23,
      "offset": 285.117,
      "cues": {
        "which": 0.2,
        "photo": 4.775,
        "list": 8.538,
        "rule": 13.574,
        "see": 16.233,
        "not": 20.526
      },
      "captions": [
        {
          "start": 0.2,
          "end": 2.455,
          "text": "So with two alices on the page,"
        },
        {
          "start": 2.523,
          "end": 4.707,
          "text": "which one does a query see?"
        },
        {
          "start": 4.775,
          "end": 6.283,
          "text": "When a query starts,"
        },
        {
          "start": 6.351,
          "end": 8.47,
          "text": "Postgres hands it a snapshot:"
        },
        {
          "start": 8.538,
          "end": 10.643,
          "text": "think of it as a photo of which"
        },
        {
          "start": 10.711,
          "end": 13.506,
          "text": "tickets had finished at that moment."
        },
        {
          "start": 13.574,
          "end": 16.165,
          "text": "Then one rule decides everything."
        },
        {
          "start": 16.233,
          "end": 18.406,
          "text": "You see a version if its creator"
        },
        {
          "start": 18.474,
          "end": 20.458,
          "text": "had finished in your photo,"
        },
        {
          "start": 20.526,
          "end": 22.438,
          "text": "and its deleter hadn't."
        }
      ]
    },
